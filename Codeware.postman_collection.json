						{
							"name": "Update Layout",
							"request": {
								"method": "PUT",
								"header": [{ "key": "Content-Type", "value": "application/json" }],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"type\": \"header\",\n    \"content\": \"<nav>...</nav>\"\n}",
									"options": { "raw": { "language": "json" } }
								},
								"url": "{{base_url}}/admin/layout"
							}
						}
					]
				},
				{
					"name": "Contacts",
					"item": [
						{
							"name": "List Contacts",
							"request": {
								"method": "GET",
								"url": {
									"raw": "{{base_url}}/admin/contacts?per_page={{per_page}}&status=unread",
									"host": ["{{base_url}}"],
									"path": ["admin", "contacts"],
									"query": [
										{ "key": "per_page", "value": "{{per_page}}" },
										{ "key": "status", "value": "unread", "disabled": true }
									]
								}
							}
						},
						{
							"name": "Get Contact by ID",
							"request": { "method": "GET", "url": "{{base_url}}/admin/contacts/{{contact_id}}" }
						},
						{
							"name": "Update Contact Status",
							"request": {
								"method": "PUT",
								"header": [{ "key": "Content-Type", "value": "application/json" }],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"status\": \"read\"\n}",
									"options": { "raw": { "language": "json" } }
								},
								"url": "{{base_url}}/admin/contacts/{{contact_id}}"
							}
						},
						{
							"name": "Delete Contact",
							"request": { "method": "DELETE", "url": "{{base_url}}/admin/contacts/{{contact_id}}" }
						}
					]
				},
				{
					"name": "Subscribers",
					"item": [
						{
							"name": "List Subscribers",
							"request": {
								"method": "GET",
								"url": {
									"raw": "{{base_url}}/admin/subscribers?per_page={{per_page}}&status=subscribed&search=",
									"host": ["{{base_url}}"],
									"path": ["admin", "subscribers"],
									"query": [
										{ "key": "per_page", "value": "{{per_page}}" },
										{ "key": "status", "value": "subscribed", "disabled": true },
										{ "key": "search", "value": "", "disabled": true }
									]
								}
							}
						},
						{
							"name": "Get Subscriber by ID",
							"request": { "method": "GET", "url": "{{base_url}}/admin/subscribers/{{subscriber_id}}" }
						},
						{
							"name": "Delete Subscriber",
							"request": { "method": "DELETE", "url": "{{base_url}}/admin/subscribers/{{subscriber_id}}" }
						}
					]
				},
				{
					"name": "Users",
					"description": "Stricter than the rest of the Admin folder: gated by `access-admin-system`, not just `access-admin` — a Staff-role account gets 403 here even though it can reach Products/Posts/etc. `{{admin_token}}` must belong to an `admin`-role account.",
					"item": [
						{
							"name": "List Users",
							"request": {
								"method": "GET",
								"url": {
									"raw": "{{base_url}}/admin/users?per_page={{per_page}}&search=&role=",
									"host": ["{{base_url}}"],
									"path": ["admin", "users"],
									"query": [
										{ "key": "per_page", "value": "{{per_page}}" },
										{ "key": "search", "value": "", "disabled": true },
										{ "key": "role", "value": "staff", "disabled": true }
									]
								}
							}
						},
						{
							"name": "Get User by ID",
							"request": { "method": "GET", "url": "{{base_url}}/admin/users/{{user_id}}" }
						},
						{
							"name": "Create User",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"if (pm.response.code === 201) {",
											"    const body = pm.response.json();",
											"    pm.collectionVariables.set('user_id', body.data.id);",
											"}"
										]
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [{ "key": "Content-Type", "value": "application/json" }],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"name\": \"New Staffer\",\n    \"email\": \"staffer@example.com\",\n    \"password\": \"password\",\n    \"password_confirmation\": \"password\",\n    \"roles\": [\"staff\"]\n}",
									"options": { "raw": { "language": "json" } }
								},
								"url": "{{base_url}}/admin/users"
							}
						},
						{
							"name": "Update User",
							"request": {
								"method": "PUT",
								"header": [{ "key": "Content-Type", "value": "application/json" }],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"name\": \"Renamed Staffer\",\n    \"email\": \"staffer@example.com\",\n    \"roles\": [\"staff\"]\n}",
									"options": { "raw": { "language": "json" } }
								},
								"url": "{{base_url}}/admin/users/{{user_id}}"
							}
						},
						{
							"name": "Change User Password",
							"request": {
								"method": "PUT",
								"header": [{ "key": "Content-Type", "value": "application/json" }],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"password\": \"brand-new-password\",\n    \"password_confirmation\": \"brand-new-password\"\n}",
									"options": { "raw": { "language": "json" } }
								},
								"url": "{{base_url}}/admin/users/{{user_id}}/password"
							}
						},
						{
							"name": "Delete User",
							"request": { "method": "DELETE", "url": "{{base_url}}/admin/users/{{user_id}}" }
						}
					]
				}
			]
		}
	]
}
