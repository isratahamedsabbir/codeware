{
  "info": {
    "name": "Codeware API",
    "_postman_id": "codeware-api-v1",
    "description": "Full REST API collection for Codeware. Public endpoints require no auth. Admin endpoints require a Bearer token — set {{admin_token}} in the environment.\n\nAuth flow: GET /sanctum/csrf-cookie → POST /login → session cookie; or create a Sanctum token via `php artisan tinker` and set it as {{admin_token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get CSRF Cookie",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/sanctum/csrf-cookie",
              "host": ["{{base_url}}"],
              "path": ["sanctum", "csrf-cookie"]
            },
            "description": "Must be called before session-based login to obtain the XSRF-TOKEN cookie. Postman will automatically attach it on subsequent requests."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            },
            "description": "Session-based login via Fortify. For API token auth instead, create a token in Tinker: `$user->createToken('postman')->plainTextToken` and paste the result into {{admin_token}}."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": ["{{base_url}}"],
              "path": ["logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Public — Posts",
      "item": [
        {
          "name": "List Posts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{api_url}}/posts?locale={{locale}}&per_page=15",
              "host": ["{{api_url}}"],
              "path": ["posts"],
              "query": [
                { "key": "locale", "value": "{{locale}}", "description": "en or bn" },
                { "key": "per_page", "value": "15" },
                { "key": "category", "value": "", "disabled": true, "description": "Filter by category slug" },
                { "key": "tag", "value": "", "disabled": true, "description": "Filter by tag slug" },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Post by Slug",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{api_url}}/posts/:slug?locale={{locale}}",
              "host": ["{{api_url}}"],
              "path": ["posts", ":slug"],
              "variable": [{ "key": "slug", "value": "my-post-slug" }],
              "query": [
                { "key": "locale", "value": "{{locale}}", "description": "en or bn" }
              ]
            }
          }
        }
      ]
    },
