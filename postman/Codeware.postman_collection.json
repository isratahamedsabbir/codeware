								"header": [{ "key": "Content-Type", "value": "application/json" }],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"status\": \"active\",\n    \"seo_title\": \"Updated SEO Title\",\n    \"puck_data\": { \"root\": { \"props\": {} }, \"content\": [] }\n}",
									"options": { "raw": { "language": "json" } }
								},
								"url": "{{base_url}}/admin/products/{{product_id}}"
							}
