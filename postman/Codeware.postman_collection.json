						{
							"name": "Create User",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"if (pm.response.code === 201) {",
											"    const body = pm.response.json();",
											"    pm.collectionVariables.set('user_id', body.data.id);",
											"}"
										]
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [{ "key": "Content-Type", "value": "application/json" }],
