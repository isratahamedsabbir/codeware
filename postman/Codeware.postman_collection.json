				},
				{
					"name": "Users",
					"description": "Stricter than the rest of the Admin folder: gated by `access-admin-system`, not just `access-admin` — a Staff-role account gets 403 here even though it can reach Products/Posts/etc. `{{admin_token}}` must belong to an `admin`-role account.",
					"item": [
						{
							"name": "List Users",
							"request": {
								"method": "GET",
								"url": {
									"raw": "{{base_url}}/admin/users?per_page=15&search=&role=",
									"host": ["{{base_url}}"],
									"path": ["admin", "users"],
									"query": [
										{ "key": "per_page", "value": "15" },
										{ "key": "search", "value": "", "disabled": true },
										{ "key": "role", "value": "staff", "disabled": true }
									]
								}
							}
						},
						{
							"name": "Get User by ID",
							"request": { "method": "GET", "url": "{{base_url}}/admin/users/{{user_id}}" }
