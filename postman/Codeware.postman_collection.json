									"raw": "{\n    \"name\": \"Renamed Staffer\",\n    \"email\": \"staffer@example.com\",\n    \"is_admin\": false,\n    \"roles\": [\"staff\"]\n}",
									"options": { "raw": { "language": "json" } }
								},
