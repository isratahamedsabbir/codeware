									"raw": "{\n    \"name\": \"New Staffer\",\n    \"email\": \"staffer@example.com\",\n    \"password\": \"password\",\n    \"password_confirmation\": \"password\",\n    \"is_admin\": false,\n    \"roles\": [\"staff\"]\n}",
									"options": { "raw": { "language": "json" } }
								},
								"url": "{{base_url}}/admin/users"
							}
						},
