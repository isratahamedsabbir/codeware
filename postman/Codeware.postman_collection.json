									"raw": "{\n    \"name\": \"New Staffer\",\n    \"email\": \"staffer@example.com\",\n    \"password\": \"password\",\n    \"password_confirmation\": \"password\",\n    \"roles\": [\"staff\"]\n}",
									"options": { "raw": { "language": "json" } }
								},
								"url": "{{base_url}}/admin/users"
							}
						},
						{
							"name": "Update User",
							"request": {
								"method": "PUT",
								"header": [{ "key": "Content-Type", "value": "application/json" }],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"name\": \"Renamed Staffer\",\n    \"email\": \"staffer@example.com\",\n    \"roles\": [\"staff\"]\n}",
									"options": { "raw": { "language": "json" } }
								},
								"url": "{{base_url}}/admin/users/{{user_id}}"
